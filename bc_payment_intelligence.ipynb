   "source": "# ── Scoring model transparency: weights per profile ────────────────────────────\nprint()\nprint(\"=\" * 82)\nprint(\"  SCORING MODEL — Dimension Weights by Profile\")\nprint(\"=\" * 82)\nprint(\"  All weights sum to 1.0. Zero = intentionally excluded for that context.\")\nprint()\n\ndims = list(next(iter(MERCHANT_PROFILES.values()))[\"weights\"].keys())\nrows = []\nfor pk, profile in MERCHANT_PROFILES.items():\n    row = {\"Profile\": profile[\"name\"]}\n    row.update({d: profile[\"weights\"][d] for d in dims})\n    rows.append(row)\n\nwdf = pd.DataFrame(rows).set_index(\"Profile\")\nprint(wdf.to_string())\nprint()"
